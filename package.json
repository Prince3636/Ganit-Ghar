{
  "name": "ganit-ghar",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Ganit Ghar – Multi-Platform Offline Math Learning & Gaming Suite (Mobile APK & Desktop)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "cap:add": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:open": "cap open android",
    "build:apk": "npm run build && cap sync && node scripts/build-apk-help.js",
    "desktop:dev": "vite build && electron electron/main.cjs",
    "build:desktop": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  }
}
